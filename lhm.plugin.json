    {
      "name": "get_flight_price_calendar",
      "description": "Календарь цен на авиабилеты за месяц (YYYY-MM): цена по дням и самый дешёвый день.",
      "inputSchema": {
        "properties": {
          "origin": {
            "title": "Origin",
            "type": "string"
          },
          "destination": {
            "title": "Destination",
            "type": "string"
          },
          "month": {
            "description": "Месяц, YYYY-MM",
            "title": "Month",
            "type": "string"
          },
          "direct": {
            "default": false,
            "title": "Direct",
            "type": "boolean"
          }
        },
        "required": [
          "origin",
          "destination",
          "month"
        ],
        "title": "get_flight_price_calendarArguments",
        "type": "object"
      }
    },
    {
      "name": "get_cheapest_travelata_tours",
      "description": "Быстрая подборка самых дешёвых пакетных туров только из Travelata. Один запрос вместо полного поиска по двум источникам.",
      "inputSchema": {
        "properties": {
          "departure_city": {
            "title": "Departure City",
            "type": "string"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "date_from": {
            "description": "Начало окна дат заезда/вылета, YYYY-MM-DD, не в прошлом",
            "title": "Date From",
            "type": "string"
          },
          "date_to": {
            "description": "Конец окна, YYYY-MM-DD; окно не длиннее 30 дней",
            "title": "Date To",
            "type": "string"
          },
          "nights_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Nights Min"
          },
          "nights_max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Nights Max"
          },
          "adults": {
            "default": 2,
            "title": "Adults",
            "type": "integer"
          },
          "kids_ages": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Kids Ages"
          },
          "resorts": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "До 5 курортов страны, по-русски",
            "title": "Resorts"
          },
          "meals": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Коды питания: RO — без питания, BB — завтраки, HB — полупансион, FB — полный пансион, AI — всё включено, UAI — ультра всё включено",
            "title": "Meals"
          },
          "stars_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stars Min"
          },
          "limit": {
            "default": 10,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "departure_city",
          "country",
          "date_from",
          "date_to"
        ],
        "title": "get_cheapest_travelata_toursArguments",
        "type": "object"
      }
    },
    {
      "name": "get_tour_details",
      "description": "Актуализация выбранного тура перед бронированием: подтверждённая цена, трансфер, номера. offer_id — из результатов search_tours, get_cheapest_travelata_tours или search_hotels.",
